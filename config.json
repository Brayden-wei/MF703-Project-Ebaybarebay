{
  "data": {
    "raw_path": "data/raw/btcusd_1-min_data.csv",
    "processed_dir": "data/processed",
    "timezone": "UTC"
  },
  "task": {
    "horizon_minutes": 15,
    "sample_interval_minutes": 15,
    "target": "simple_return"
  },
  "split": {
    "development_start": "2017-01-01",
    "development_end_exclusive": "2024-01-01",
    "test_start": "2024-01-01",
    "test_end": "last_valid_timestamp",
    "validation_years": [
      2021,
      2022,
      2023
    ]
  },
  "random_seed": 42,
  "output_dir": "outputs"
}
