{
  "data": {
    "processed_dir": "data/processed",
    "timezone": "UTC",
    "raw_dir": "data/raw",
    "raw_glob": "btcusd_1-min_data.part-*.parquet",
    "raw_path": "data/raw/btcusd_1-min_data.parquet",
    "raw_source": "team_cloud_storage",
    "raw_version": "raw-v1",
    "evaluation_index_path": "data/processed/evaluation_index.csv"
  },
  "task": {
    "horizon_minutes": 15,
    "sample_interval_minutes": 15,
    "target": "log_return"
  },
  "split": {
    "development_start": "2017-01-01",
    "development_end_exclusive": "2024-01-01",
    "test_start": "2024-01-01",
    "test_end": "last_valid_timestamp",
    "validation_years": [
      2021,
      2022,
      2023
    ]
  },
  "random_seed": 42,
  "output_dir": "comparison",
  "predictions_dir": "results",
  "metrics": [
    "rmse",
    "mae"
  ]
}
